<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cortex.discovery-chain-index</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/opt/cortex-harness/scripts/discovery-chain-index.mjs</string>
    <string>serve</string>
    <string>--index</string><string>/var/lib/cortex/discovery-index</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8795</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
